# === House of Singhana — Environment Configuration ===

# Server
PORT=3000
NODE_ENV=production

# Authentication
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Razorpay (Get from https://dashboard.razorpay.com → Settings → API Keys)
# Use rzp_test_ keys for testing, rzp_live_ keys for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Twilio SMS / WhatsApp Provider
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+919145907801
TWILIO_WHATSAPP_NUMBER=+1234567890
